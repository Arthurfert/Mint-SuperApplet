{
    "head-layout": {
        "type": "header",
        "description": "Dashboard"
    },
    "refresh-interval": {
        "type": "spinbutton",
        "default": 2000,
        "min": 500,
        "max": 10000,
        "step": 100,
        "units": "ms",
        "description": "Update interval"
    },
    "popup-width": {
        "type": "spinbutton",
        "default": 520,
        "min": 360,
        "max": 900,
        "step": 10,
        "units": "px",
        "description": "Popup dashboard width"
    },
    "popup-height": {
        "type": "spinbutton",
        "default": 440,
        "min": 280,
        "max": 700,
        "step": 10,
        "units": "px",
        "description": "Popup dashboard height"
    },
    "font-size": {
        "type": "spinbutton",
        "default": 10,
        "min": 8,
        "max": 16,
        "step": 1,
        "units": "px",
        "description": "Base font size"
    },
    "head-sections": {
        "type": "header",
        "description": "Sections"
    },
    "show-cpu": {
        "type": "switch",
        "default": true,
        "description": "Show CPU panel"
    },
    "show-memory": {
        "type": "switch",
        "default": true,
        "description": "Show memory panel"
    },
    "memory-include-cache-buffers": {
        "type": "switch",
        "default": true,
        "description": "Include cache and buffers in memory graph"
    },
    "show-network": {
        "type": "switch",
        "default": true,
        "description": "Show network panel"
    },
    "show-disk": {
        "type": "switch",
        "default": true,
        "description": "Show disk I/O panel"
    },
    "show-temps": {
        "type": "switch",
        "default": true,
        "description": "Show temperatures strip"
    },
    "head-panel": {
        "type": "header",
        "description": "Panel indicator"
    },
    "panel-show-cpu": {
        "type": "switch",
        "default": true,
        "description": "Show CPU mini-bar in panel"
    },
    "panel-show-memory": {
        "type": "switch",
        "default": true,
        "description": "Show memory mini-bar in panel"
    },
    "head-colors": {
        "type": "header",
        "description": "Colors"
    },
    "color-primary": {
        "type": "colorchooser",
        "default": "#8b5cf6",
        "description": "Primary accent (CPU, disk read, memory used)"
    },
    "color-secondary": {
        "type": "colorchooser",
        "default": "#e879f9",
        "description": "Secondary accent (memory total, disk write)"
    },
    "color-tertiary": {
        "type": "colorchooser",
        "default": "#fb923c",
        "description": "Tertiary accent (network down, swap, warm temps)"
    },
    "color-cyan": {
        "type": "colorchooser",
        "default": "#22d3ee",
        "description": "Cyan accent (memory cache, network up, cool temps)"
    },
    "color-error": {
        "type": "colorchooser",
        "default": "#ff5757",
        "description": "Critical color (high usage, hot temps)"
    },
    "color-background": {
        "type": "colorchooser",
        "default": "#12111e",
        "description": "Dashboard background"
    },
    "color-surface": {
        "type": "colorchooser",
        "default": "#1f1d30",
        "description": "Panel card background"
    },
    "color-surface-high": {
        "type": "colorchooser",
        "default": "#2e2c45",
        "description": "Ring track / bar background"
    },
    "color-text": {
        "type": "colorchooser",
        "default": "#ece6ff",
        "description": "Primary text color"
    },
    "color-text-variant": {
        "type": "colorchooser",
        "default": "#c9c0e8",
        "description": "Secondary text color"
    }
}
